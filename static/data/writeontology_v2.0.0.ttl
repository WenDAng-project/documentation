@prefix : <https://w3id.org/write/ontology#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix write: <https://w3id.org/write/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/write/ontology#> .

<https://w3id.org/write/ontology> rdf:type owl:Ontology ;
                                   owl:versionIRI :v2.0.0 ;
                                   dcterms:contributor """Adriana Iezzi (domain expert)
Martina Merenda (domain expert)
Daniele Caccin (domain expert)
Marta R. Bisceglia (domain expert)
Valentina Pasqual (former contributor on the core draft v0.1.0)""" ;
                                   dcterms:creator "Katarina Lučić" ;
                                   dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                   dcterms:modified "2026-10-28"^^xsd:date ;
                                   dcterms:subject "\"Chinese calligraphy\", \"contemporary calligraphy\", \"contemporary arts\", \"visual arts\", \"graffiti\", \"performing art\", \"decorative and applied arts\"" ;
                                   dcterms:version "2.0.0" ;
                                   rdfs:comment "The WRITE ontology provides a semantic model for contemporary Chinese calligraphy and its intersections with visual, performing, graffiti, and decorative and applied arts. It describes artworks, their calligraphic and writing-like components, literary works, people in different roles, exhibitions, artwork series, and other contextual elements, supporting their structured representation and analysis within the WRITE knowledge graph."@en ,
                                                "This ontology was developed in collaboration with the domain experts, all of whom are members of the WRITE project team. To learn more about the project, please visit: https://writecalligraphyproject.eu/."@en ;
                                   rdfs:label "WRITE ontology" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
dcterms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/subject
dcterms:subject rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/version
dcterms:version rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#scopeNote
skos:scopeNote rdf:type owl:AnnotationProperty .


###  https://w3id.org/write/ontology#accuracy
:accuracy rdf:type owl:AnnotationProperty ;
          rdfs:comment "Indicates that a value is approximate or uncertain." ;
          rdfs:label "accuracy" .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.wikidata.org/prop/direct/P103
wdt:P103 rdf:type owl:ObjectProperty ;
         rdfs:comment "Language or languages a person has learned from early childhood." ;
         rdfs:label "native language" ;
         skos:scopeNote "Native language of the person. For other languages that the person speaks, writes or signs, use 'uses language'." .


###  http://www.wikidata.org/prop/direct/P106
wdt:P106 rdf:type owl:ObjectProperty ;
         rdfs:comment "Occupation of the person." ;
         rdfs:label "occupation" .


###  http://www.wikidata.org/prop/direct/P10661
wdt:P10661 rdf:type owl:ObjectProperty ;
           rdfs:comment "Intellectual or creative entity (person or organisation) responsible for the elements exhibited." ;
           rdfs:label "exhibited artist" ;
           skos:scopeNote "Artist(s) whose artworks are displayed in the exhibition." .


###  http://www.wikidata.org/prop/direct/P1071
wdt:P1071 rdf:type owl:ObjectProperty ;
          rdfs:comment "Place where the item was conceived or made." ;
          rdfs:label "location of creation" ;
          skos:scopeNote "Indicates the city or country where a specific artwork or artworks' series were created." .


###  http://www.wikidata.org/prop/direct/P127
wdt:P127 rdf:type owl:ObjectProperty ;
         rdfs:comment "Owner of the subject." ;
         rdfs:label "owner" ;
         skos:scopeNote "Person, artistic collective or organisation who is the proprietor of the artwork." .


###  http://www.wikidata.org/prop/direct/P1303
wdt:P1303 rdf:type owl:ObjectProperty ;
          rdfs:comment "Musical instrument that a person plays or teaches or used in a music occupation." ;
          rdfs:label "musical instrument" ;
          skos:scopeNote "Musical instrument used during a performing arts event." .


###  http://www.wikidata.org/prop/direct/P1412
wdt:P1412 rdf:type owl:ObjectProperty ;
          rdfs:comment "Language(s) that a person or a people speaks, writes or signs, including the native language(s)." ;
          rdfs:label "uses language" ;
          skos:scopeNote "Languages other than native, that the person speaks, writes or signs." .


###  http://www.wikidata.org/prop/direct/P144
wdt:P144 rdf:type owl:ObjectProperty ;
         rdfs:comment "The work(s) or inputs used as the basis for subject item." ;
         rdfs:label "based on" ;
         skos:scopeNote "Literary work on which the Calli-Writing unit is based." .


###  http://www.wikidata.org/prop/direct/P1640
wdt:P1640 rdf:type owl:ObjectProperty ;
          rdfs:comment "Content specialist responsible for the collection or exhibition." ;
          rdfs:label "curator" .


###  http://www.wikidata.org/prop/direct/P170
wdt:P170 rdf:type owl:ObjectProperty ;
         rdfs:comment "Maker of the creative work or other object." ;
         rdfs:label "creator" ;
         skos:scopeNote "Person or artistic collective that created the visual or graffiti artwork, an artwork series, or a traditional artwork." .


###  http://www.wikidata.org/prop/direct/P175
wdt:P175 rdf:type owl:ObjectProperty ;
         rdfs:comment "Actor, musician, band or other performer associated with this role or musical work." ;
         rdfs:label "performer" ;
         skos:scopeNote "Person or artistic collective that took part in a performing arts event as a performer, including roles such as dancer, musician, singer, or actor." .


###  http://www.wikidata.org/prop/direct/P176
wdt:P176 rdf:type owl:ObjectProperty ;
         rdfs:comment "Manufacturer or producer of the product." ;
         rdfs:label "manufacturer" .


###  http://www.wikidata.org/prop/direct/P179
wdt:P179 rdf:type owl:ObjectProperty ;
         rdfs:comment "Series which contains the subject." ;
         rdfs:label "is part of series" ;
         skos:scopeNote "Connects the artwork to the series it belongs to." .


###  http://www.wikidata.org/prop/direct/P180
wdt:P180 rdf:type owl:ObjectProperty ;
         rdfs:comment "Entity visually depicted in an image, literarily described in a work, or otherwise incorporated into an audiovisual or other medium." ;
         rdfs:label "depicts" ;
         skos:scopeNote "Relates an artwork or a \"Calli-Writing\" unit to a concrete, thematic, conceptual, formal, aesthetic, or procedural element that contributes to its content or interpretation." .


###  http://www.wikidata.org/prop/direct/P186
wdt:P186 rdf:type owl:ObjectProperty ;
         rdfs:comment "Material the subject or the object is made of or derived from." ;
         rdfs:label "made from material" ;
         skos:scopeNote "Material used in the creation of the artwork / Calli-Writing unit, applied to a support (e.g. ink, paper)." .


###  http://www.wikidata.org/prop/direct/P19
wdt:P19 rdf:type owl:ObjectProperty ;
        rdfs:comment "Most specific known birth location of a person." ;
        rdfs:label "place of birth" .


###  http://www.wikidata.org/prop/direct/P20
wdt:P20 rdf:type owl:ObjectProperty ;
        rdfs:comment "Most specific known death location of a person." ;
        rdfs:label "place of death" .


###  http://www.wikidata.org/prop/direct/P21
wdt:P21 rdf:type owl:ObjectProperty ;
        rdfs:comment "Gender identity of the person." ;
        rdfs:label "gender" .


###  http://www.wikidata.org/prop/direct/P27
wdt:P27 rdf:type owl:ObjectProperty ;
        rdfs:comment "Country of citizenship of the person." ;
        rdfs:label "country of citizenship" .


###  http://www.wikidata.org/prop/direct/P276
wdt:P276 rdf:type owl:ObjectProperty ;
         rdfs:comment "Location of the object, structure or event." ;
         rdfs:label "location" ;
         skos:scopeNote "Indicates a specific geographical location (such as a building, city, or country) where an event took place, an artwork is located, or an organisation / artistic collective is based." .


###  http://www.wikidata.org/prop/direct/P282
wdt:P282 rdf:type owl:ObjectProperty ;
         rdfs:comment "Alphabet, character set or other system of writing used by a language, word, or text, supported by a typeface." ;
         rdfs:label "writing system" ;
         skos:scopeNote "Characters, alphabet or other system of writing used in a Calli-Writing unit, including the non-traditional writing systems such as Dunhuang Musical score." .


###  http://www.wikidata.org/prop/direct/P287
wdt:P287 rdf:type owl:ObjectProperty ;
         rdfs:comment "Person or organisation which designed the object. For buildings use 'architect'." ;
         rdfs:label "designer" ;
         skos:scopeNote "Person or artistic collective responsible for designing a piece of decorative and applied art." .


###  http://www.wikidata.org/prop/direct/P407
wdt:P407 rdf:type owl:ObjectProperty ;
         rdfs:comment "Language associated with this creative work (such as books, shows, songs, broadcasts or websites) or a name." ;
         rdfs:label "language" ;
         skos:scopeNote "Language associated with the Calli-Writing unit." .


###  http://www.wikidata.org/prop/direct/P462
wdt:P462 rdf:type owl:ObjectProperty ;
         rdfs:comment "Colour of subject." ;
         rdfs:label "has colour" ;
         skos:scopeNote "Colour used in the making of an artwork or a Calli-Writing unit (for the latter, distinct from 'background colour')." .


###  http://www.wikidata.org/prop/direct/P463
wdt:P463 rdf:type owl:ObjectProperty ;
         rdfs:comment "Organisation, club or musical group to which the subject belongs." ;
         rdfs:label "is member of" ;
         skos:scopeNote "An artistic collective or organisation a person belongs to." .


###  http://www.wikidata.org/prop/direct/P50
wdt:P50 rdf:type owl:ObjectProperty ;
        rdfs:comment "Main creator of a written work." ;
        rdfs:label "author" .


###  http://www.wikidata.org/prop/direct/P608
wdt:P608 rdf:type owl:ObjectProperty ;
         rdfs:comment "Exhibition(s) where the artwork is or was displayed." ;
         rdfs:label "exhibition history" .


###  http://www.wikidata.org/prop/direct/P664
wdt:P664 rdf:type owl:ObjectProperty ;
         rdfs:comment "Person or organisation responsible for organising an event." ;
         rdfs:label "organiser" .


###  http://www.wikidata.org/prop/direct/P812
wdt:P812 rdf:type owl:ObjectProperty ;
         rdfs:comment "Major someone studied at college/university." ;
         rdfs:label "field of study" .


###  http://www.wikidata.org/prop/direct/P84
wdt:P84 rdf:type owl:ObjectProperty ;
        rdfs:comment "Person or architectural firm responsible for designing the building." ;
        rdfs:label "architect" .


###  http://www.wikidata.org/prop/direct/P856
wdt:P856 rdf:type owl:ObjectProperty ;
         rdfs:comment "URL of the official page of an item." ;
         rdfs:label "official website" .


###  http://www.wikidata.org/prop/direct/P86
wdt:P86 rdf:type owl:ObjectProperty ;
        rdfs:comment "Person(s) who wrote the music." ;
        rdfs:label "composer" ;
        skos:scopeNote "Person who composed the music for the performing arts event." .


###  http://www.wikidata.org/prop/direct/P88
wdt:P88 rdf:type owl:ObjectProperty ;
        rdfs:comment "Person or organisation that commissioned the work." ;
        rdfs:label "commissioner" .


###  http://www.wikidata.org/prop/direct/P9302
wdt:P9302 rdf:type owl:ObjectProperty ;
          rdfs:comment "Style of script of a document or typeface." ;
          rdfs:label "script style" ;
          skos:scopeNote "Indicates a specific form / style of the Chinese script used in a Calli-Writing unit." .


###  http://www.wikidata.org/prop/direct/P937
wdt:P937 rdf:type owl:ObjectProperty ;
         rdfs:comment "Location where persons are actively participating in employment, business or other work." ;
         rdfs:label "place of activity" .


###  http://www.wikidata.org/prop/direct/P941
wdt:P941 rdf:type owl:ObjectProperty ;
         rdfs:comment "Work, human, place or event which inspired this creative work or fictional entity." ;
         rdfs:label "inspired by" .


###  http://www.wikidata.org/prop/direct/P973
wdt:P973 rdf:type owl:ObjectProperty ;
         rdfs:comment "Item is described at the following URL." ;
         rdfs:label "described at URL" .


###  https://w3id.org/write/ontology#calligrapher
:calligrapher rdf:type owl:ObjectProperty ;
              owl:inverseOf :isCalligrapherOf ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( wd:Q184485
                                          :DecorativeAndAppliedArts
                                        )
                          ] ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( wd:Q1400264
                                         wd:Q215627
                                       )
                         ] ;
              rdfs:comment "Indicates the calligrapher who took part in a performing arts event or who produced the calligraphy for a decorative and applied artwork." ;
              rdfs:label "calligrapher" .


###  https://w3id.org/write/ontology#createsArtwork
:createsArtwork rdf:type owl:ObjectProperty ;
                owl:inverseOf :derivesFrom ;
                rdfs:domain wd:Q184485 ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( wd:Q4502142
                                           :DecorativeAndAppliedArts
                                         )
                           ] ;
                owl:propertyDisjointWith :usesArtwork ;
                rdfs:comment "Indicates the artwork created during a performing arts event." ;
                rdfs:label "creates artwork" .


###  https://w3id.org/write/ontology#derivesFrom
:derivesFrom rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( wd:Q4502142
                                         :DecorativeAndAppliedArts
                                       )
                         ] ;
             rdfs:range wd:Q184485 ;
             rdfs:comment "Indicates the performing arts event from which the visual or decorative artwork derives from." ;
             rdfs:label "derives from" .


###  https://w3id.org/write/ontology#exhibitedArtwork
:exhibitedArtwork rdf:type owl:ObjectProperty ;
                  rdfs:domain wd:Q464980 ;
                  rdfs:range [ rdf:type owl:Class ;
                               owl:unionOf ( wd:Q184485
                                             wd:Q4502142
                                             wd:Q7725310
                                             :DecorativeAndAppliedArts
                                           )
                             ] ;
                  rdfs:comment "Artwork(s) displayed in the exhibition (including those represented within the artworks' series)." ;
                  rdfs:label "exhibited artwork" .


###  https://w3id.org/write/ontology#hasArtisticCollectiveType
:hasArtisticCollectiveType rdf:type owl:ObjectProperty ;
                           rdfs:domain wd:Q1400264 ;
                           rdfs:range owl:Thing ;
                           rdfs:comment "Indicates the type of the artistic collective (e.g., graffiti crew, dance company, architectural firm, etc.)." ;
                           rdfs:label "has artistic collective type" .


###  https://w3id.org/write/ontology#hasBackgroundColour
:hasBackgroundColour rdf:type owl:ObjectProperty ;
                     rdfs:domain :CalliWritingUnit ;
                     rdfs:range owl:Thing ;
                     rdfs:comment "Background colour of the Calli-Writing Unit." ;
                     rdfs:label "has background colour" .


###  https://w3id.org/write/ontology#hasCharacterForm
:hasCharacterForm rdf:type owl:ObjectProperty ;
                  rdfs:domain :CalliWritingUnit ;
                  rdfs:range owl:Thing ;
                  rdfs:comment "Form of the Chinese character present in a Calli-Writing unit, i.e. simplified or non simplified Chinese character." ;
                  rdfs:label "has character form" .


###  https://w3id.org/write/ontology#hasChineseConcept
:hasChineseConcept rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( wd:Q17514
                                               wd:Q184485
                                               :DecorativeAndAppliedArts
                                             )
                               ] ;
                   rdfs:range skos:Concept ;
                   rdfs:comment "Philosophical, literary, cultural, social or other concept or notion represented within the artwork." ;
                   rdfs:label "has Chinese concept" .


###  https://w3id.org/write/ontology#hasChineseVisualElement
:hasChineseVisualElement rdf:type owl:ObjectProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( wd:Q17514
                                                     wd:Q184485
                                                     :DecorativeAndAppliedArts
                                                   )
                                     ] ;
                         rdfs:range skos:Concept ;
                         owl:propertyDisjointWith :hasOtherVisualElement ;
                         rdfs:comment "Visual element or motif derived from Chinese culture that appears in the artwork." ;
                         rdfs:label "has Chinese visual element" .


###  https://w3id.org/write/ontology#hasDecorativeArtworkType
:hasDecorativeArtworkType rdf:type owl:ObjectProperty ;
                          rdfs:domain :DecorativeAndAppliedArts ;
                          rdfs:range owl:Thing ;
                          rdfs:comment "Indicates the typology of a decorative and applied artwork." ;
                          rdfs:label "has decorative artwork type" .


###  https://w3id.org/write/ontology#hasGraffitiGenre
:hasGraffitiGenre rdf:type owl:ObjectProperty ;
                  rdfs:domain wd:Q17514 ;
                  rdfs:range skos:Concept ;
                  rdfs:comment "Provides the classification of a graffiti artwork by genre." ;
                  rdfs:label "has graffiti genre" .


###  https://w3id.org/write/ontology#hasGraffitiStyle
:hasGraffitiStyle rdf:type owl:ObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( wd:Q17514
                                              :CalliWritingUnit
                                            )
                              ] ;
                  rdfs:range skos:Concept ;
                  rdfs:comment "Indicates the visual style applied in the creation of a graffiti artwork." ;
                  rdfs:label "has graffiti style" .


###  https://w3id.org/write/ontology#hasGraffitiType
:hasGraffitiType rdf:type owl:ObjectProperty ;
                 rdfs:domain wd:Q17514 ;
                 rdfs:range skos:Concept ;
                 rdfs:comment "Indicates a specific type or category of graffiti, defined by its form or medium." ;
                 rdfs:label "has graffiti type" .


###  https://w3id.org/write/ontology#hasMember
:hasMember rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( wd:Q1400264
                                       wd:Q43229
                                     )
                       ] ;
           rdfs:range wd:Q215627 ;
           rdfs:comment "Indicates individuals who are members of an artistic collective or organisation." ;
           rdfs:label "has member" .


###  https://w3id.org/write/ontology#hasOrganisationType
:hasOrganisationType rdf:type owl:ObjectProperty ;
                     rdfs:domain wd:Q43229 ;
                     rdfs:range owl:Thing ;
                     rdfs:comment "Provides the classification of an organisation." ;
                     rdfs:label "has organisation type" .


###  https://w3id.org/write/ontology#hasOtherVisualElement
:hasOtherVisualElement rdf:type owl:ObjectProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( wd:Q17514
                                                   :DecorativeAndAppliedArts
                                                 )
                                   ] ;
                       rdfs:range owl:Thing ;
                       rdfs:comment "Non-Chinese visual element (motif) that appears in the artwork." ;
                       rdfs:label "has other visual element" .


###  https://w3id.org/write/ontology#hasPerformingArtworkType
:hasPerformingArtworkType rdf:type owl:ObjectProperty ;
                          rdfs:domain wd:Q184485 ;
                          rdfs:range skos:Concept ;
                          rdfs:comment "Indicates the specific type or genre of a performing artwork." ;
                          rdfs:label "has performing artwork type" .


###  https://w3id.org/write/ontology#hasTraditionalArtworkType
:hasTraditionalArtworkType rdf:type owl:ObjectProperty ;
                           rdfs:domain :TraditionalArtwork ;
                           rdfs:range owl:Thing ;
                           rdfs:comment "Indicates the type of the traditional artwork." ;
                           rdfs:label "has traditional artwork type" .


###  https://w3id.org/write/ontology#hasUnit
:hasUnit rdf:type owl:ObjectProperty ;
         owl:inverseOf :isUnitOf ;
         rdfs:domain :WriteCollections ;
         rdfs:range :CalliWritingUnit ;
         rdfs:comment "Connects the artwork to the Calli-Writing unit." ;
         rdfs:label "has unit" .


###  https://w3id.org/write/ontology#hasVisualArtworkType
:hasVisualArtworkType rdf:type owl:ObjectProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( wd:Q4502142
                                                  :TraditionalArtwork
                                                )
                                  ] ;
                      rdfs:range owl:Thing ;
                      rdfs:comment "Indicates the type of the visual artwork (e.g., calligraphic work, installation, print, etc.)." ;
                      rdfs:label "has visual artwork type" .


###  https://w3id.org/write/ontology#hasWikidataResource
:hasWikidataResource rdf:type owl:ObjectProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( wd:Q1400264
                                                 wd:Q215627
                                                 wd:Q43229
                                                 wd:Q464980
                                                 wd:Q7725310
                                                 wd:Q7725634
                                                 :TraditionalArtwork
                                                 :WriteCollections
                                               )
                                 ] ;
                     rdfs:range owl:Thing ;
                     rdfs:comment "Wikidata resource which identifies the record." ;
                     rdfs:label "has Wikidata resource" .


###  https://w3id.org/write/ontology#includesArtwork
:includesArtwork rdf:type owl:ObjectProperty ;
                 rdfs:domain wd:Q7725310 ;
                 rdfs:range :WriteCollections ;
                 rdfs:comment "Indicates artwork from four WRITE collections included in the series." ;
                 rdfs:label "includes artwork" .


###  https://w3id.org/write/ontology#isCalligrapherOf
:isCalligrapherOf rdf:type owl:ObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( wd:Q1400264
                                              wd:Q215627
                                            )
                              ] ;
                  rdfs:range [ rdf:type owl:Class ;
                               owl:unionOf ( wd:Q184485
                                             :DecorativeAndAppliedArts
                                           )
                             ] ;
                  rdfs:comment "Indicates a performing arts event or a decorative and applied artwork for which the person created calligraphy." ;
                  rdfs:label "is calligrapher of" .


###  https://w3id.org/write/ontology#isComposerOf
:isComposerOf rdf:type owl:ObjectProperty ;
              rdfs:domain wd:Q215627 ;
              rdfs:range wd:Q184485 ;
              rdfs:comment "Indicates a performing arts event for which the person composed the music." ;
              rdfs:label "is composer of" .


###  https://w3id.org/write/ontology#isCreatorOf
:isCreatorOf rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( wd:Q1400264
                                         wd:Q215627
                                         wd:Q43229
                                       )
                         ] ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( wd:Q17514
                                        wd:Q4502142
                                        wd:Q7725310
                                        :TraditionalArtwork
                                      )
                        ] ;
             rdfs:comment "Indicates the artwork or artwork series created by the person, artistic collective, or an organisation." ;
             rdfs:label "is creator of" .


###  https://w3id.org/write/ontology#isCuratorOf
:isCuratorOf rdf:type owl:ObjectProperty ;
             rdfs:domain wd:Q215627 ;
             rdfs:range wd:Q464980 ;
             rdfs:comment "Indicates the exhibition curated by the person." ;
             rdfs:label "is curator of" .


###  https://w3id.org/write/ontology#isDesignerOf
:isDesignerOf rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( wd:Q1400264
                                          wd:Q215627
                                          wd:Q43229
                                        )
                          ] ;
              rdfs:range :DecorativeAndAppliedArts ;
              rdfs:comment "Indicates the decorative and applied artwork designed by the person, artistic collective, or an organisation." ;
              rdfs:label "is designer of" .


###  https://w3id.org/write/ontology#isPerformerOf
:isPerformerOf rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
